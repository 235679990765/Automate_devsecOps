FROM node:20-alpine

WORKDIR /app

COPY package*.json ./

{% if node_dependency_analysis and node_dependency_analysis.safe_production_install %}
RUN npm ci --only=production --legacy-peer-deps && npm cache clean --force
{% else %}
RUN npm ci --legacy-peer-deps --omit=dev || npm install --legacy-peer-deps && npm cache clean --force
{% endif %}

COPY . .

RUN addgroup -S app && adduser -S app -G app
USER app

EXPOSE {{ port }}

CMD ["npm", "start"]
